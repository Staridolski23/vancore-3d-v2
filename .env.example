# Supabase Configuration
# Copy this to .env.local and fill in your values
# DO NOT commit .env.local to git!

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional free AI pilot. Leave disabled until the private admission migration,
# free account verification and synthetic quality tests have passed.
# Preview branch only initially. Never prefix secrets with NEXT_PUBLIC_.
VERA_AI_MODE=legacy
VERA_AI_CUSTOMER_ENABLED=false
GROQ_API_KEY=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VERA_GROQ_FREE_CONFIRMED=false
VERA_CLOUDFLARE_FREE_CONFIRMED=false
